{
  "domain": "cubby.graham.lol",
  "githubRepo": "git@github.com:grahamotte/Cubby.git",
  "database": "cubby",
  "site": {
    "title": "Cubby",
    "description": "A fast, simple file manager for macOS.",
    "themeColor": "oklch(0 0 0)"
  },
  "subdomains": [
    {
      "name": "www",
      "subdomains": [
        "",
        "www"
      ],
      "directory": "frontend/subdomains/www"
    },
    {
      "name": "hc",
      "subdomains": [
        "hc"
      ],
      "directory": "frontend/subdomains/hc"
    },
    {
      "name": "jobs",
      "subdomains": [
        "jobs"
      ],
      "backend": true
    }
  ],
  "instance": {
    "region": "sfo3",
    "size": "s-1vcpu-2gb"
  },
  "apps": {
    "build": "0.4.0",
    "homebrew": {
      "desc": "Fast, simple file manager with list, icon, and column views",
      "macos": "golden_gate",
      "zap": [
        "~/.config/cubby",
        "~/Library/Preferences/com.grahamotte.cubby.plist",
        "~/Library/Saved Application State/com.grahamotte.cubby.savedState"
      ]
    },
    "marketingUrl": "https://github.com/grahamotte/Cubby",
    "name": "Cubby",
    "skip_app_stores": true,
    "supportUrl": "https://github.com/grahamotte/Cubby",
    "targets": {
      "apple": {
        "macos": {
          "archiveDestination": "generic/platform=macOS",
          "bundleIdentifier": "com.grahamotte.cubby",
          "platform": "MAC_OS",
          "project": "apps/apple/App.xcodeproj",
          "scheme": "Cubby",
          "simulatorDestination": "platform=macOS",
          "simulatorProduct": "Debug/Cubby.app",
          "simulators": {
            "macos": "Mac"
          }
        }
      },
      "android": {}
    },
    "version": "0.4.0",
    "whatsNew": "A sort menu in the top bar, an optional Count column in list view, a Keyboard Shortcuts page in settings, Cmd-Left and Cmd-Right for Back and Forward, a setting to show .DS_Store files with hidden files, simpler settings, and cleaner multi-row selection."
  }
}
