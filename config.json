{
  "domain": "cubby.graham.lol",
  "githubRepo": "git@github.com:grahamotte/Cubby.git",
  "database": "cubby",
  "site": {
    "title": "Cubby",
    "description": "A fast, simple file manager for macOS.",
    "themeColor": "oklch(0 0 0)"
  },
  "subdomains": [
    {
      "name": "www",
      "subdomains": [
        "",
        "www"
      ],
      "directory": "frontend/subdomains/www"
    },
    {
      "name": "hc",
      "subdomains": [
        "hc"
      ],
      "directory": "frontend/subdomains/hc"
    },
    {
      "name": "jobs",
      "subdomains": [
        "jobs"
      ],
      "backend": true
    }
  ],
  "instance": {
    "region": "sfo3",
    "size": "s-1vcpu-2gb"
  },
  "apps": {
    "build": "0.2.0",
    "homebrew": {
      "desc": "Fast, simple file manager with list, icon, column, and gallery views",
      "macos": "golden_gate",
      "zap": [
        "~/.config/cubby",
        "~/Library/Preferences/com.grahamotte.cubby.plist",
        "~/Library/Saved Application State/com.grahamotte.cubby.savedState"
      ]
    },
    "marketingUrl": "https://github.com/grahamotte/Cubby",
    "name": "Cubby",
    "skip_app_stores": true,
    "supportUrl": "https://github.com/grahamotte/Cubby",
    "targets": {
      "apple": {
        "macos": {
          "archiveDestination": "generic/platform=macOS",
          "bundleIdentifier": "com.grahamotte.cubby",
          "platform": "MAC_OS",
          "project": "apps/apple/App.xcodeproj",
          "scheme": "Cubby",
          "simulatorDestination": "platform=macOS",
          "simulatorProduct": "Debug/Cubby.app",
          "simulators": {
            "macos": "Mac"
          }
        }
      },
      "android": {}
    },
    "version": "0.2.0",
    "whatsNew": "A calmer new look: a full-height sidebar, a clickable path bar with view and layout controls, soft light and dark surfaces with rounded selection, and no status bar. Settings now open in the window. Tabs are gone in favor of split panes; Cmd-click in the sidebar opens a new window."
  }
}
