---
import config from "../../../config.json";
import InstallCommand from "../components/InstallCommand.astro";
import Layout from "../layouts/Layout.astro";

const repoUrl = config.apps.marketingUrl;
const install = "brew install grahamotte/tap/cubby";

const features = [
  {
    title: "Fast on huge folders",
    text: "Folders with 100,000 or more items open in a fraction of a second.",
    keys: [],
  },
  {
    title: "Up to four panes",
    text: "One pane, side by side, stacked, three, or four. Each pane browses on its own, so you can drag files between them.",
    keys: ["⌥⌘1", "–", "⌥⌘5"],
  },
  {
    title: "List, icons, or columns",
    text: "Folders expand in place in the list. List and icon views show Quick Look thumbnails, and Space opens Quick Look.",
    keys: ["⌘1", "⌘2", "⌘3"],
  },
  {
    title: "Folders remember their view",
    text: "Each folder keeps its own view, sort, and icon size, even after you rename or move it. Panes remember where you were scrolled.",
    keys: [],
  },
  {
    title: "A sidebar you arrange",
    text: "Folders in groups that nest. Drag to add and reorder, and drop files on a folder to move them there. Hold ⌥ to copy.",
    keys: [],
  },
  {
    title: "Filter as you type",
    text: "Narrow the current folder to what you're looking for, or jump anywhere with Go to Folder.",
    keys: ["⌘F", "⇧⌘G"],
  },
  {
    title: "The basics, with undo",
    text: "Copy, paste, rename, duplicate, compress, and Move to Trash work the way you expect from Finder, and every one can be undone.",
    keys: ["⌘Z"],
  },
];

const themes = [
  { name: "Workbench", light: ["#FCFCFB", "#F1F1EF", "#007AFF", "#000000"], dark: ["#1E1F21", "#17181A", "#0A84FF", "#FFFFFF"] },
  { name: "Grove", light: ["#F3F7F4", "#E2EDE7", "#1B7D50", "#241523"], dark: ["#1B2821", "#21362B", "#69D69A", "#FFFAFF"] },
  { name: "Ocean", light: ["#F5F7F8", "#E4ECF2", "#2672AF", "#241523"], dark: ["#17212B", "#1E2D3B", "#70B9EE", "#FFFAFF"] },
  { name: "Ember", light: ["#F9F7F5", "#F3EAE5", "#AE552A", "#241523"], dark: ["#291E1A", "#39281F", "#F09A64", "#FFFAFF"] },
  { name: "Iris", light: ["#F8F7F9", "#EDEAF4", "#7253B9", "#241523"], dark: ["#1D1929", "#272139", "#9D7DF2", "#FFFAFF"] },
  { name: "Bubblegum", light: ["#FDF7FD", "#F2E1F4", "#DB2777", "#501854"], dark: ["#1F1A24", "#171018", "#A3004C", "#F9F8FB"] },
];

const swatchStyle = (theme: (typeof themes)[number]) =>
  ["content", "sidebar", "accent", "text"]
    .map((role, index) => `--${role}: light-dark(${theme.light[index]}, ${theme.dark[index]})`)
    .join("; ");
---

<Layout>
  <section class="mx-auto w-full max-w-6xl px-6 pt-14 sm:px-8 sm:pt-20">
    <div class="max-w-2xl">
      <h1 class="text-[2.5rem] leading-[1.08] font-semibold tracking-[-0.03em] text-balance sm:text-[3.5rem]">
        A quiet file manager for your Mac.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-ink-2">
        Cubby is a small, fast Finder replacement for everyday browsing, organizing, and moving files. It opens huge
        folders in a blink, splits a window into up to four panes, and never leaves a <code class="font-mono text-[0.92em]">.DS_Store</code> behind.
      </p>
      <div class="mt-9 flex flex-col items-start gap-x-6 sm:flex-row sm:flex-wrap sm:items-center gap-y-4">
        <InstallCommand command={install} class="bg-card" />
        <a href={`${repoUrl}/releases/latest`} class="text-[0.9375rem] font-medium underline">Or download the app</a>
      </div>
      <p class="mt-5 text-sm text-ink-2">
        Free and open source. Version {config.apps.version}, for macOS 27 or later. Signed and notarized by Apple.
      </p>
    </div>
  </section>

  <section class="mx-auto mt-10 w-full max-w-6xl px-2 sm:mt-14 sm:px-4">
    <img
      src="/screenshot.webp"
      width="2000"
      height="1386"
      alt="A Cubby window in the Grove theme. A sidebar of nested folder groups sits beside an icon view of photos, PDFs, and folders with Quick Look thumbnails."
      class="h-auto w-full"
      fetchpriority="high"
    />
  </section>

  <section class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-20 sm:px-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16 md:py-28">
    <div>
      <h2 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-balance md:sticky md:top-10">
        The everyday things, done well
      </h2>
      <p class="mt-4 max-w-sm leading-relaxed text-ink-2">Cubby does fewer things than Finder, and it's built to do them quickly and stay out of the way.</p>
    </div>
    <ul class="border-t border-line">
      {
        features.map((feature) => (
          <li class="flex flex-col gap-3 border-b border-line py-6 sm:flex-row sm:items-start sm:justify-between sm:gap-10">
            <div class="max-w-lg">
              <h3 class="font-semibold">{feature.title}</h3>
              <p class="mt-1.5 leading-relaxed text-ink-2">{feature.text}</p>
            </div>
            {feature.keys.length > 0 && (
              <div class="flex shrink-0 items-center gap-1.5 sm:pt-0.5">
                {feature.keys.map((key) => (key === "–" ? <span class="text-ink-3">–</span> : <kbd>{key}</kbd>))}
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-sidebar">
    <div class="mx-auto w-full max-w-6xl px-6 py-20 sm:px-8 md:py-28">
      <div class="max-w-xl">
        <h2 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-balance">Profiles for different parts of your life</h2>
        <p class="mt-4 leading-relaxed text-ink-2">
          Each profile has its own sidebar and color theme, such as Personal and Work. Switch between them from the bottom of the
          sidebar. Every theme comes in light and dark and follows your Mac's appearance.
        </p>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
        {
          themes.map((theme) => (
            <li>
              <div
                style={swatchStyle(theme)}
                class="flex aspect-[4/3] overflow-hidden rounded-[10px] border border-line bg-[var(--content)]"
                aria-hidden="true"
              >
                <div class="flex w-[38%] flex-col gap-[9%] bg-[var(--sidebar)] px-[9%] pt-[16%]">
                  <span class="h-1.5 w-1/2 rounded-full bg-[var(--text)] opacity-25" />
                  <span class="-mx-[18%] flex h-3.5 items-center rounded-[4px] px-[18%] [background:color-mix(in_srgb,var(--text)_10%,transparent)]">
                    <span class="h-1.5 w-4/5 rounded-full bg-[var(--text)] opacity-60" />
                  </span>
                  <span class="h-1.5 w-3/5 rounded-full bg-[var(--text)] opacity-40" />
                  <span class="h-1.5 w-4/5 rounded-full bg-[var(--text)] opacity-40" />
                </div>
                <div class="flex flex-1 flex-col gap-[7%] px-[7%] pt-[16%]">
                  <span class="h-1.5 w-2/3 rounded-full bg-[var(--text)] opacity-40" />
                  <span class="-mx-[5%] flex h-3.5 items-center rounded-[4px] px-[5%] [background:color-mix(in_srgb,var(--accent)_22%,transparent)]">
                    <span class="h-1.5 w-3/4 rounded-full bg-[var(--text)] opacity-70" />
                  </span>
                  <span class="h-1.5 w-1/2 rounded-full bg-[var(--text)] opacity-40" />
                  <span class="h-1.5 w-3/5 rounded-full bg-[var(--text)] opacity-40" />
                  <span class="h-1.5 w-2/5 rounded-full bg-[var(--text)] opacity-40" />
                </div>
              </div>
              <p class="mt-3 text-sm font-medium">{theme.name}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto grid w-full max-w-6xl items-center gap-10 px-6 py-20 sm:px-8 md:grid-cols-2 md:gap-16 md:py-28">
    <div class="max-w-lg">
      <h2 class="text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-balance">Your folders stay yours</h2>
      <p class="mt-4 leading-relaxed text-ink-2">
        Cubby never writes <code class="font-mono text-[0.92em]">.DS_Store</code> or any other file into the folders you browse.
      </p>
      <p class="mt-4 leading-relaxed text-ink-2">
        Its own settings live in <code class="font-mono text-[0.92em]">~/.config/cubby</code> as plain JSON. Edit{" "}
        <code class="font-mono text-[0.92em]">config.json</code> by hand and Cubby picks up the change the moment you save.
      </p>
    </div>
    <figure class="overflow-hidden rounded-[10px] border border-line bg-card">
      <figcaption class="border-b border-line px-4 py-2.5 font-mono text-[0.8125rem] text-ink-2">~/.config/cubby/config.json</figcaption>
      <pre class="overflow-x-auto px-4 py-4 font-mono text-[0.8125rem] leading-relaxed"><code>{`{
  "appearance": "system",
  "showHiddenFiles": false,
  "terminal": "Terminal",
  "profile": 0,
  "profiles": [
    {
      "name": "Personal",
      "icon": "person",
      "theme": "grove",
      "sidebar": [
        {
          "group": "Favorites",
          "items": [
            { "folder": "~/Inbox" },
            { "folder": "~/Photos" },
            { "folder": "~/Documents" }
          ]
        }
      ]
    }
  ]
}`}</code></pre>
    </figure>
  </section>

  <section class="mx-auto w-full max-w-6xl px-6 pb-24 sm:px-8 md:pb-32">
    <div class="flex flex-col items-start gap-6 rounded-[14px] border border-line bg-card px-4 py-8 sm:px-10 sm:py-10 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-5">
        <img src="/icon.png" alt="" width="64" height="64" class="size-16 shrink-0" loading="lazy" />
        <div>
          <h2 class="text-[1.375rem] font-semibold tracking-[-0.015em]">Give Cubby a try</h2>
          <p class="mt-1 text-ink-2">Install with Homebrew, then update with <code class="font-mono text-[0.92em]">brew upgrade</code>.</p>
        </div>
      </div>
      <InstallCommand command={install} class="bg-page" />
    </div>
  </section>
</Layout>

